@page

<head>
    <title>Book CRUD</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css"/>

</head>

<body>

    <h2>Add new Books</h2>

    <form class="add_form">

        <div class="form_body">
            <div>
                <h3>Name</h3>
                <input type="text" class="input_name" placeholder="1984" required/>
            </div>

            <div>
                <h3>Author</h3>
                <input type="text" class="input_author" placeholder="George" />
            </div>

            <div>
                <h3>Editorial</h3>
                <input type="text" class="input_editorial" placeholder="Debolsillo" />
            </div>
        </div>

        

        <div class="form_button">
            <button type="submit" class="Add_button">Agregar</button>
        </div>

    </form>

</body>